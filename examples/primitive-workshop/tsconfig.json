{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "shared/**/*.js",
    "vanilla/physical-actions.js",
    "vanilla/lifecycle.js",
    "vanilla/**/*.ts",
    "react/physical-actions.js",
    "react/lifecycle.js",
    "react/**/*.tsx"
  ]
}
